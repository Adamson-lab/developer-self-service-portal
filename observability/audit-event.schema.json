{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://portal.example/schemas/audit-event.schema.json",
  "title": "Portal audit event",
  "type": "object",
  "required": ["seq", "ts", "event", "prev_hash", "hash"],
  "properties": {
    "seq": { "type": "integer", "minimum": 1 },
    "ts": { "type": "string", "format": "date-time" },
    "event": {
      "enum": ["request.submitted", "request.provisioning", "request.approved", "request.declined",
               "request.approval_denied", "request.ready", "request.failed"]
    },
    "request_id": { "type": "string" },
    "requester": { "type": "string" },
    "approver": { "type": "string" },
    "template": { "type": "string" },
    "status": { "type": "string" },
    "reasons": { "type": "array", "items": { "type": "string" } },
    "prev_hash": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "hash": { "type": "string", "pattern": "^[a-f0-9]{64}$" }
  },
  "additionalProperties": true
}
